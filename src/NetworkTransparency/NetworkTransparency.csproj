<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WindowsTelemetryInspector.Cli</AssemblyName>
    <RootNamespace>NetworkTransparency</RootNamespace>
    <Product>Windows Telemetry Inspector CLI</Product>
    <Description>Command-line interface for passive Windows ETW network inspection.</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NetworkTransparency.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetworkTransparency.Core\NetworkTransparency.Core.csproj" />
  </ItemGroup>
</Project>
