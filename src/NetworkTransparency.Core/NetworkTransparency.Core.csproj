<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WindowsTelemetryInspector.Core</AssemblyName>
    <RootNamespace>NetworkTransparency.Core</RootNamespace>
    <Description>Shared capture, correlation, persistence, and analysis engine for Windows Telemetry Inspector.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetworkTransparency.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.3" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>
</Project>
