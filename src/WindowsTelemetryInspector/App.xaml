<Application x:Class="WindowsTelemetryInspector.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:WindowsTelemetryInspector.ViewModels"
             xmlns:views="clr-namespace:WindowsTelemetryInspector.Views"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewModels:LiveTrafficViewModel}">
                <views:LiveTrafficView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ProcessesViewModel}">
                <views:ProcessesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ServicesViewModel}">
                <views:ServicesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:DnsViewModel}">
                <views:DnsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:TimelineViewModel}">
                <views:TimelineView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:CapturesViewModel}">
                <views:CapturesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SummaryViewModel}">
                <views:SummaryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
