<UserControl x:Class="WindowsTelemetryInspector.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Traffic timeline" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Time buckets adapt to capture duration. Bar intensity represents relative traffic volume within the retained window." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" AutomationProperties.Name="Traffic timeline buckets">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Bucket start" Width="165"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StartedUtc, Converter={StaticResource DateTimeConverter}, ConverterParameter=yyyy-MM-dd HH:mm}" FontFamily="Consolas" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="110" />
                <DataGridTextColumn Header="Events" Binding="{Binding EventCount, StringFormat={}{0:N0}}" Width="90" />
                <DataGridTemplateColumn Header="Sent" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BytesSent, Converter={StaticResource BytesConverter}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Received" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BytesReceived, Converter={StaticResource BytesConverter}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Relative volume" Width="*" MinWidth="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><ProgressBar Value="{Binding Intensity}" Maximum="100" ToolTip="{Binding TotalBytes, Converter={StaticResource BytesConverter}}" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Dominant process" Binding="{Binding DominantProcess}" Width="190" />
                <DataGridTemplateColumn Header="Dominant category" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding DominantCategory, Converter={StaticResource CategoryBrushConverter}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"><TextBlock Text="{Binding DominantCategory}" FontSize="11" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
