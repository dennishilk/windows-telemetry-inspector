<UserControl x:Class="WindowsTelemetryInspector.Views.LiveTrafficView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="245" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="220" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search process, PID, protocol, endpoint, host, service, category, or related task (Ctrl+K)"
                     AutomationProperties.Name="Search live traffic"
                     Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      AutomationProperties.Name="Category filter"
                      Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Filters" Command="{Binding ToggleFiltersCommand}" Margin="0,0,8,0" />

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Content="{Binding DataContext.RecordButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.ToggleRecordingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="Record or stop recording capture" Margin="0,0,8,0" />
                <Button Content="Export JSONL"
                        Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="Export current events as JSONL" Margin="0,0,8,0" />
                <Button Content="Open Capture"
                        Command="{Binding DataContext.OpenCaptureCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="Open a JSONL capture" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="10"
                Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.65*" />
                    <ColumnDefinition Width="0.65*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Process" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="2,0,0,3" />
                    <TextBox Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter by process" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="PID" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="2,0,0,3" />
                    <TextBox Text="{Binding PidFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter by PID" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Protocol" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="2,0,0,3" />
                    <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" AutomationProperties.Name="Filter by protocol" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Remote host / IP" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="2,0,0,3" />
                    <TextBox Text="{Binding RemoteFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter by remote host or IP" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="Service" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="2,0,0,3" />
                    <TextBox Text="{Binding ServiceFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter by service" />
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                    <TextBlock Text="DNS name" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="2,0,0,3" />
                    <TextBox Text="{Binding DnsFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter by DNS name" />
                </StackPanel>
                <Button Grid.Column="6" Content="Clear" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <DataGrid x:Name="EventGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding EventsView}"
                  SelectedItem="{Binding SelectedEvent}"
                  AutoGenerateColumns="False"
                  FrozenColumnCount="2"
                  AutomationProperties.Name="Live network events">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Time" Width="104" SortMemberPath="TimestampUtc">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TimestampUtc, Converter={StaticResource DateTimeConverter}}" FontFamily="Consolas" FontSize="11" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="150" />
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65" />
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="72" />
                <DataGridTextColumn Header="Local Address" Binding="{Binding LocalEndpoint}" Width="145" />
                <DataGridTextColumn Header="Remote Address" Binding="{Binding RemoteEndpoint}" Width="150" />
                <DataGridTextColumn Header="Remote Host" Binding="{Binding RemoteHost}" Width="220" />
                <DataGridTemplateColumn Header="Bytes Sent" Width="92" SortMemberPath="BytesSent">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BytesSent, Converter={StaticResource BytesConverter}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Bytes Recv" Width="92" SortMemberPath="BytesRecv">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BytesRecv, Converter={StaticResource BytesConverter}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Category" Width="145" SortMemberPath="Classification">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Classification, Converter={StaticResource CategoryBrushConverter}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Classification}" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Confidence" Width="88" SortMemberPath="Confidence">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Confidence, StringFormat={}{0:P0}}" Foreground="{Binding Confidence, Converter={StaticResource ConfidenceBrushConverter}}" FontWeight="SemiBold" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" />

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0">
            <TabControl>
                <TabItem Header="Selected Event Details">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Timestamp" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEvent.TimestampUtc, Converter={StaticResource DateTimeConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss.fff}" Style="{StaticResource DetailValueStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Direction" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedEvent.Direction, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />

                                <TextBlock Grid.Row="1" Text="Process" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEvent.ProcessName, TargetNullValue=Select an event}" Style="{StaticResource DetailValueStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="PID / User" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="3"><Run Text="{Binding SelectedEvent.Pid}" /><Run Text="  ·  " /><Run Text="{Binding SelectedEvent.User, TargetNullValue=Not available}" /></TextBlock>

                                <TextBlock Grid.Row="2" Text="Local endpoint" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEvent.LocalEndpoint, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Protocol" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedEvent.Protocol, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />

                                <TextBlock Grid.Row="3" Text="Bytes sent" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEvent.BytesSent, Converter={StaticResource BytesConverter}}" Style="{StaticResource DetailValueStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Bytes received" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding SelectedEvent.BytesRecv, Converter={StaticResource BytesConverter}}" Style="{StaticResource DetailValueStyle}" />

                                <TextBlock Grid.Row="4" Text="Category" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEvent.Classification, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="Confidence" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding SelectedEvent.Confidence, StringFormat={}{0:P0}}" Foreground="{Binding SelectedEvent.Confidence, Converter={StaticResource ConfidenceBrushConverter}}" />

                                <TextBlock Grid.Row="5" Text="ETW provider" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedEvent.EtwProvider, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="Notes" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding SelectedEvent.Notes, TargetNullValue=Not available}" TextWrapping="Wrap" Style="{StaticResource DetailValueStyle}" />
                            </Grid>

                            <Border Grid.Column="2" Background="#0C1721" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.ColumnSpan="2" Text="Remote endpoint" Foreground="#67BEF4" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="1" Text="IP address" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEvent.RemoteIp, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="2" Text="Port" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEvent.RemotePort, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="3" Text="Host" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEvent.RemoteHost, TargetNullValue=Not resolved}" Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="4" Text="DNS state" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEvent.DnsCorrelation, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="No external endpoint enrichment is performed automatically." Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Process Info">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Executable" Style="{StaticResource DetailLabelStyle}" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEvent.Process.ProcessName, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Description" Style="{StaticResource DetailLabelStyle}" /><TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedEvent.Process.Description, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock Grid.Row="1" Text="Company" Style="{StaticResource DetailLabelStyle}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEvent.Process.Company, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Signer" Style="{StaticResource DetailLabelStyle}" /><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedEvent.Process.Signer, TargetNullValue=Not resolved}" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock Grid.Row="2" Text="Path" Style="{StaticResource DetailLabelStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedEvent.Process.ExecutablePath, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock Grid.Row="3" Text="Command line" Style="{StaticResource DetailLabelStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedEvent.Process.CommandLine, TargetNullValue=Not available}" TextWrapping="Wrap" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock Grid.Row="4" Text="Parent process" Style="{StaticResource DetailLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEvent.Process.ParentProcess, TargetNullValue=Not resolved}" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Start time" Style="{StaticResource DetailLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding SelectedEvent.Process.StartTimeUtc, Converter={StaticResource DateTimeConverter}, ConverterParameter=yyyy-MM-dd HH:mm:ss}" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock Grid.Row="5" Text="Integrity level" Style="{StaticResource DetailLabelStyle}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedEvent.Process.IntegrityLevel, TargetNullValue=Not available}" Style="{StaticResource DetailValueStyle}" />
                            <TextBlock Grid.Row="6" Text="Services" Style="{StaticResource DetailLabelStyle}" /><TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedEvent.ServiceNames, Converter={StaticResource CollectionToTextConverter}}" Style="{StaticResource DetailValueStyle}" />
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Service Info">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Services are associated with the observed process ID. For shared service hosts, this does not identify which individual service initiated the traffic."
                                   Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedEvent.ServiceDetails}" AutoGenerateColumns="False" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Service" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*" />
                                <DataGridTextColumn Header="Observed state" Binding="{Binding State}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="DNS Lookups">
                    <StackPanel Margin="12">
                        <TextBlock Text="DNS correlation is best effort. Cached, encrypted, or missing DNS activity may not be available." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding SelectedEvent.DnsNames, Converter={StaticResource CollectionToTextConverter}}" TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Correlated Tasks">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Possible relationship only — nearby task timing does not prove that a scheduled task caused this traffic."
                                   Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedEvent.CorrelatedTasks}" AutoGenerateColumns="False" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Related task" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                                <DataGridTemplateColumn Header="Nearby execution" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LastRunUtc, Converter={StaticResource DateTimeConverter}, ConverterParameter=HH:mm:ss}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Time distance" Binding="{Binding DistanceDisplay}" Width="115" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
