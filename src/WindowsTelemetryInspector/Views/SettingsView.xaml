<UserControl x:Class="WindowsTelemetryInspector.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="900" HorizontalAlignment="Left">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="A small set of operational settings for capture fidelity and interface responsiveness." Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="Capture" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                        <CheckBox Content="Include Windows DNS Client events" IsChecked="{Binding Settings.IncludeDns}" AutomationProperties.Name="Include Windows DNS Client events" />
                        <TextBlock Text="DNS correlation remains best effort and may miss cached or encrypted DNS." Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="22,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Text="Interface and storage" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />

                    <StackPanel Grid.Row="1" Margin="0,0,20,12"><TextBlock Text="UI refresh interval" /><TextBlock Text="Events are delivered to the table in batches." Style="{StaticResource MutedTextStyle}" FontSize="11" /></StackPanel>
                    <ComboBox Grid.Row="1" Grid.Column="1" Width="160" HorizontalAlignment="Left" ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding Settings.RefreshIntervalMilliseconds}" AutomationProperties.Name="UI refresh interval in milliseconds">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} ms}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Grid.Row="2" Margin="0,0,20,12"><TextBlock Text="Maximum in-memory events" /><TextBlock Text="Older rows are removed from the live table; recorded files remain complete." Style="{StaticResource MutedTextStyle}" FontSize="11" /></StackPanel>
                    <ComboBox Grid.Row="2" Grid.Column="1" Width="160" HorizontalAlignment="Left" ItemsSource="{Binding MaximumEventCounts}" SelectedItem="{Binding Settings.MaximumInMemoryEvents}" AutomationProperties.Name="Maximum events retained in memory">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0:N0}}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Grid.Row="3" Margin="0,0,20,0"><TextBlock Text="Capture folder" /><TextBlock Text="Default destination for recordings and exports." Style="{StaticResource MutedTextStyle}" FontSize="11" /></StackPanel>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.CaptureDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Default capture directory" Margin="0,0,8,0" />
                    <Button Grid.Row="3" Grid.Column="2" Content="Open" Command="{Binding OpenFolderCommand}" />
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CheckBox Content="Auto-scroll the live table to new visible events" IsChecked="{Binding Settings.AutoScroll}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Save Settings" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
