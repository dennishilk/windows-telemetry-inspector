<UserControl x:Class="WindowsTelemetryInspector.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Associated Windows services" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Service-hosted traffic mapped from observed process IDs. A service association identifies the host process; it does not prove which hosted service initiated an individual event." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedService}" AutoGenerateColumns="False"
                  AutomationProperties.Name="Services associated with observed traffic">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Service" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*" MinWidth="220" />
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
                <DataGridTextColumn Header="Processes" Binding="{Binding ProcessCount}" Width="90" />
                <DataGridTextColumn Header="Events" Binding="{Binding EventCount, StringFormat={}{0:N0}}" Width="90" />
                <DataGridTemplateColumn Header="Sent" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BytesSent, Converter={StaticResource BytesConverter}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Received" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BytesReceived, Converter={StaticResource BytesConverter}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Dominant category" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding DominantCategory, Converter={StaticResource CategoryBrushConverter}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"><TextBlock Text="{Binding DominantCategory}" FontSize="11" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Selected service" Style="{StaticResource DetailLabelStyle}" /><TextBlock Grid.Column="1" Text="{Binding SelectedService.Name, TargetNullValue=Select a service}" Style="{StaticResource DetailValueStyle}" />
                <TextBlock Grid.Column="2" Text="Observed state" Style="{StaticResource DetailLabelStyle}" /><TextBlock Grid.Column="3" Text="{Binding SelectedService.State, TargetNullValue=Unknown}" Style="{StaticResource DetailValueStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
